# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_TOKEN: Access token from Meta WhatsApp Cloud API
WHATSAPP_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: The Phone Number ID shown in Meta's API Setup
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"

# WHATSAPP_TEMPLATE_NAME: Name of the approved message template
WHATSAPP_TEMPLATE_NAME="shipping_update"

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Arbitrary secret string for webhook verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN="MY_WEBHOOK_VERIFY_TOKEN"

# SUPPORT_INBOX_URL: The support inbox Worker. Each WhatsApp send is copied there
# so agents see the caption and packing list image.
SUPPORT_INBOX_URL="https://support.anda-support.workers.dev"

# SUPPORT_INBOX_SECRET: Must match AUTOMATION_SECRET on the support inbox Worker.
SUPPORT_INBOX_SECRET="MY_SUPPORT_INBOX_SECRET"
