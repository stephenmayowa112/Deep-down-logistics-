# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_TOKEN: Access token from Meta WhatsApp Cloud API (System User
# permanent token for production, or the temporary token from API Setup
# while testing). Never commit the real value.
WHATSAPP_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"

# WHATSAPP_PHONE_NUMBER_ID: The Phone Number ID shown in Meta's API Setup
# page for your WhatsApp Business phone number.
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"

# WHATSAPP_TEMPLATE_NAME: Name of the approved message template used for
# shipment status notifications. Defaults to "shipment_status_update".
WHATSAPP_TEMPLATE_NAME="shipment_status_update"
