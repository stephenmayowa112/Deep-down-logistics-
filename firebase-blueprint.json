{
  "entities": {
    "User": {
      "title": "User",
      "description": "Platform user account (client, base admin, or super admin)",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "staff", "client"] },
        "phone_number": { "type": "string", "maxLength": 40 },
        "shipping_mark": { "type": "string", "minLength": 1, "maxLength": 100 },
        "is_verified": { "type": "boolean" },
        "account_status": { "type": "string", "enum": ["approved", "pending", "suspended"] },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" },
        "last_modified_by": { "type": "string", "maxLength": 200 },
        "last_modified_by_email": { "type": "string", "maxLength": 200 }
      },
      "required": ["role", "phone_number", "shipping_mark", "is_verified"]
    },
    "Container": {
      "title": "Container",
      "description": "Shipping container manifest group",
      "type": "object",
      "properties": {
        "container_number": { "type": "string", "maxLength": 64 },
        "origin_office": { "type": "string", "maxLength": 100 },
        "departure_date": { "type": "string", "maxLength": 64 },
        "created_at": { "type": "number" }
      },
      "required": ["container_number", "origin_office", "departure_date", "created_at"]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Individual client cargo shipment record with modification audit trail",
      "type": "object",
      "properties": {
        "tracking_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "client_id": { "type": "string", "maxLength": 128 },
        "container_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "shipping_mark": { "type": "string", "minLength": 1, "maxLength": 128 },
        "phone_number": { "type": "string", "maxLength": 40 },
        "ctn": { "type": "number" },
        "cbm": { "type": "number" },
        "freight_usd_per_cbm": { "type": "number" },
        "clearing_naira_per_cbm": { "type": "number" },
        "status": {
          "type": "string",
          "enum": [
            "received_china",
            "shipped",
            "in_transit_sea",
            "in_transit_air",
            "arrived_lagos",
            "customs_clearing",
            "cleared",
            "ready_for_pickup",
            "out_for_delivery",
            "delivered"
          ]
        },
        "created_at": { "type": "number" },
        "updated_at": { "type": "number" },
        "last_modified_by": { "type": "string", "maxLength": 200 },
        "last_modified_by_email": { "type": "string", "maxLength": 200 },
        "last_modified_by_role": { "type": "string", "maxLength": 64 },
        "last_modified_action": { "type": "string", "maxLength": 250 }
      },
      "required": [
        "tracking_id",
        "container_id",
        "shipping_mark",
        "phone_number",
        "ctn",
        "cbm",
        "status",
        "created_at",
        "updated_at"
      ]
    },
    "TrackingUpdate": {
      "title": "TrackingUpdate",
      "description": "Historical status and modification log entry for a shipment",
      "type": "object",
      "properties": {
        "shipment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string" },
        "note": { "type": "string", "maxLength": 500 },
        "created_at": { "type": "number" },
        "modified_by": { "type": "string", "maxLength": 200 },
        "modified_by_email": { "type": "string", "maxLength": 200 }
      },
      "required": ["shipment_id", "status", "note", "created_at"]
    },
    "PricingSettings": {
      "title": "PricingSettings",
      "description": "Global exchange rate and freight/clearing calculator rates",
      "type": "object",
      "properties": {
        "exchangeRateUsdNgn": { "type": "number" },
        "seaFreightRateUsd": { "type": "number" },
        "seaClearingRateNgn": { "type": "number" },
        "airFreightRateUsd": { "type": "number" },
        "airClearingRateNgn": { "type": "number" },
        "updated_at": { "type": "number" },
        "last_modified_by": { "type": "string", "maxLength": 200 },
        "last_modified_by_email": { "type": "string", "maxLength": 200 }
      },
      "required": [
        "exchangeRateUsdNgn",
        "seaFreightRateUsd",
        "seaClearingRateNgn",
        "airFreightRateUsd",
        "airClearingRateNgn"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts for clients, base admins, and super admins"
    },
    "/containers/{containerId}": {
      "schema": { "$ref": "#/entities/Container" },
      "description": "Shipping containers"
    },
    "/shipments/{shipmentId}": {
      "schema": { "$ref": "#/entities/Shipment" },
      "description": "Cargo shipments"
    },
    "/tracking_updates/{updateId}": {
      "schema": { "$ref": "#/entities/TrackingUpdate" },
      "description": "Audit and tracking timeline updates for shipments"
    },
    "/settings/{docId}": {
      "schema": { "$ref": "#/entities/PricingSettings" },
      "description": "Application pricing and rate settings"
    }
  }
}
