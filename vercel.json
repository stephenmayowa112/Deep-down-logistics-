{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/inventory",
      "destination": "https://deepdownlogistics-inventory.vercel.app/inventory"
    },
    {
      "source": "/inventory/:path*",
      "destination": "https://deepdownlogistics-inventory.vercel.app/inventory/:path*"
    },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|inventory).*)", "destination": "/index.html" }
  ]
}
