rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // In this preview, we can designate users as admin based on a role, or we can just say if they are authenticated and we set their custom claims.
      // Alternatively, reading the role from users collection:
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /containers/{containerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /shipments/{shipmentId} {
      // Clients and guest users can read shipments for public tracking
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tracking_updates/{updateId} {
      allow read: if true; // We fetch these by server for public tracking or they are fetched by client
      allow write: if isAdmin();
    }
  }
}
